---
import BaseLayout from "@/layouts/BaseLayout.astro";

import { getBrandData } from "@/lib/api";
import Button from "@/components/ui/Button.astro";

const brandData = await getBrandData();
---

<BaseLayout brandData={brandData}>
  <section class="pt-5 pb-20">
    <div class="container">
      <div class="_404 flex flex-col items-center">
        <div class="flex items-center gap-3 py-10 lg:py-20 font-heading">
          <span class="text-[clamp(180px,15vw,381px)] py-10 px-3 text-text-primary-inverse rounded-4xl bg-button-surface-primary font-semibold text-trim">4</span>
          <span class="text-[clamp(180px,15vw,381px)] py-10 px-3 text-text-primary-inverse rounded-4xl bg-button-surface-primary font-semibold text-trim">0</span>
          <span class="text-[clamp(180px,15vw,381px)] py-10 px-3 text-text-primary-inverse rounded-4xl bg-button-surface-primary font-semibold text-trim">4</span>
        </div>
        <p class="typo-t1 text-center">Такой страницы не существует</p>
        <Button href="/" variant="accent" class="mt-7" text="На главную" />
      </div>
    </div>
  </section></BaseLayout
>
