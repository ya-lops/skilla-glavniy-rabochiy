---
import type { BrandData } from "@/types/brand";

interface Props {
  brandData: BrandData;
  type: "cards" | "timeline" | "flow";
}

const { brandData, type = "cards" } = Astro.props;

const stepsImages = [
  {
    title: "Делайте заказ по телефону или онлайн",
    image: "/images/how-1.webp",
  },
  {
    title: "Подписываем договор и выставляем счет",
    image: "/images/how-2.webp",
  },
  {
    title: "В оговоренный срок отправляем бригаду",
    image: "/images/how-3.webp",
  },
  {
    title: "По итогам оказания услуги направляем закрывающие",
    image: "/images/how-4.webp",
  },
];
---

<section class="how-we-work py-8 md:py-10 lg:py-20" data-cmp="HowWeWork">
  <div class="container">
    <div class="_how-we-work-inner">
      <h2 class="_how-we-work-title pb-16">Как мы работаем</h2>

      {
        type == "timeline" && (
          <div class="_how-we-work-grid grid grid-cols-1 lg:grid-cols-4 items-start gap-6 bg-surface-secondary p-6 lg:p-10 rounded-3xl lg:rounded-[40px]">
            {stepsImages.map((step: any, index: number) => (
              <div class="_how-we-work_step grid grid-cols-[1fr_auto_70px] lg:grid-cols-1 lg:items-start gap-3 lg:gap-7">
                <div class="flex shrink-0 order-last lg:order-1 self-center">
                  <img src={step.image} alt="" loading="lazy" />
                </div>

                <div class="_separator lg:translate-x-9.5 flex flex-col lg:flex-row items-center gap-6 w-full lg:my-7 order-2 translate-y-[47%]">
                  <div class="_dot size-1.5 lg:size-3 rounded-full bg-button-surface-primary" />
                  {index + 1 < stepsImages.length && (
                    <div class="_line flex-1 h-full w-0.5 lg:h-[2px] lg:w-auto bg-button-surface-primary" />
                  )}
                </div>

                <div class="_content lg:pl-10 order-1 lg:order-3">
                  <div class="_number mb-6 text-accent text-left typo-h3">{index + 1}.</div>
                  <h3 class="_title typo-t1 text-left balance">{step.title}</h3>
                </div>
              </div>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>
