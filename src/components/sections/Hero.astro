---
import Button from "@/components/ui/Button.astro";

import HeroFeatures from "../blocks/HeroFeatures.astro";

interface Props {
  brandData: any;
  type: "main" | "about";
}

const { brandData, type = "main" } = Astro.props;

import { getGlobalMinPriceWithDiscount, getDiscountPercent } from "@/utils/price";

const discount = getDiscountPercent(brandData.main.adv_price_percent);

const { price, discountedPrice, showDiscount } = getGlobalMinPriceWithDiscount(brandData.services, discount);

const firstServiceUrl = brandData.services[0].url.toLowerCase();
---

{
  type == "main" && (
    <section class="hero grid grid-cols-[100%]  bg-hero-main-surface text-hero-main-text overflow-clip" data-cmp="Hero">
      <div class="container py-5 lg:py-20">
        <div class="_hero-inner grid grid-cols-1 lg:grid-cols-[3fr_2fr] gap-3 lg:gap-6 items-stretch h-full min-h-[565px] ">
          <div class="_hero-content relative flex flex-col gap-10 p-8 lg:p-15 rounded-3xl lg:rounded-[60px] bg-surface-primary-inverse">
            <h1 class="_hero-title typo-h1 text-left text-balance">Рабочий персонал под любые задачи</h1>

            <p class="typo-t3">
              Закрываем потребности на любом объекте:
              <br />
              склады, производство, ритейл и многое другое.
            </p>

            <div class="_hero-actions flex flex-col lg:flex-row items-start lg:items-center gap-6 lg:gap-8 mb-10 lg:mb-0">
              <div class="_hero-actions-items">
                <Button href="#kp" variant="accent" text="Получить КП" />
              </div>
            </div>

            <div class="absolute top-[90%] inset-x-0 lg:inset-auto lg:left-auto lg:top-15 lg:right-0 lg:translate-x-[50%]">
              <HeroFeatures />
            </div>
          </div>

          <div class="flex items-end rounded-3xl lg:rounded-[60px] bg-surface-secondary overflow-clip">
            <img class="" src="/images/hero-main.webp" alt="" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>
  )
}

{
  type == "about" && (
    <section
      class="hero grid grid-cols-[100%] min-h-[670px] bg-hero-about-surface text-hero-about-text overflow-clip isolate"
      data-cmp="Hero"
    >
      <div class="container h-full">
        <div class="_hero-inner relative grid grid-cols-1 lg:grid-cols-[4fr_3fr] items-center lg:items-center h-full">
          <div class="_hero-content flex flex-col gap-10 py-8">
            <h1 class="_hero-title typo-h1 text-left text-balance isolate">Успешно предоставляем персонал с 2010 года</h1>

            <p class="typo-t3 text-text-secondary max-w-[473px]">
              Наша компания берет на себя подбор и организацию труда разнорабочих для выполнения задач любой сложности. Гарантируем
              оперативность, надежность и гибкие условия сотрудничества, чтобы вы могли сосредоточиться на ключевых бизнес-процессах.
            </p>

            <div class="_hero-actions flex items-center gap-8">
              <div class="_hero-actions-items">
                <Button href={`/${firstServiceUrl}`} variant="secondary" text="Наши услуги" />
              </div>
            </div>
          </div>

          <div class="_hero-image justify-self-center">
            <img src="/images/hero-about.webp" alt="" fetchpriority="high" />
          </div>
        </div>
      </div>
    </section>
  )
}
