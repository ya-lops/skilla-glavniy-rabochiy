---
import IconSvg from "../IconSvg.astro";


---

<section class="flex flex-col items-center gap-6" data-cmp="HeroFeatures">
  <div class="inline-flex items-center gap-2.5 p-3 rounded-2xl bg-text-primary-inverse rotate-[-7.25deg] translate-x-[10%]">
    <IconSvg name="24" class="text-button-surface-accent"/>
    <span class="typo-t4 text-text-secondary">Круглосуточно<br>выполняем заказы</span>
  </div>

  <div class="inline-flex items-center gap-2.5 p-3 rounded-2xl bg-text-primary-inverse rotate-[3.9deg]">
    <IconSvg name="doc" class="text-button-surface-accent"/>
    <span class="typo-t4 text-text-secondary">Работаем<br>по договору</span>
  </div>

  <div class="inline-flex items-center gap-2.5 p-3 rounded-2xl bg-text-primary-inverse rotate-[-2.99deg] translate-x-[-10%]">
    <IconSvg name="card" class="text-button-surface-accent"/>
    <span class="typo-t4 text-text-secondary">Рассрочка при<br>крупных заказах</span>
  </div>

  <div class="inline-flex items-center gap-2.5 p-3 rounded-2xl bg-text-primary-inverse rotate-[-8.45deg]">
    <IconSvg name="calendar" class="text-button-surface-accent"/>
    <span class="typo-t4 text-text-secondary">15 лет<br>на рынке</span>
  </div>
</section>
